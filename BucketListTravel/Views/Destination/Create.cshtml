@model BucketListTravel.ViewModels.Destinations.CreateDestinationViewModel

@{
    ViewData["Title"] = "Add Destination";
}

<section class="create-page">
<div class="create-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Add Destination</h1>
        <p class="text-muted mb-0">Add a place you would love to visit.</p>
    </div>
    <a asp-action="Manage" class="btn btn-outline-secondary">Back to Manage</a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card create-card">
            <div class="card-header">
                <h2 class="h5 mb-1">Destination details</h2>
                <p class="text-muted small mb-0">Enter the destination information below.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Santorini" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Country" class="form-label"></label>
                            <input asp-for="Country" class="form-control" placeholder="e.g. Greece" />
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="">-- Select category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ImageUrl" class="form-label"></label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Save Destination</button>
                        <a asp-action="Manage" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card create-card">
            <div class="card-header">
                <h2 class="h5 mb-0">Image preview</h2>
            </div>
            <div class="card-body">
                <div id="previewPlaceholder" class="destination-preview-placeholder bg-light rounded d-flex align-items-center justify-content-center">
                    <span class="text-muted">No image yet</span>
                </div>
                <img id="previewImage" class="destination-preview-image img-fluid rounded" alt="Destination preview" hidden />
                <p class="small text-muted mt-3 mb-0">The preview updates when you enter an image URL.</p>
            </div>
        </div>
    </div>
</div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var urlInput = document.getElementById('ImageUrl');
            var previewImg = document.getElementById('previewImage');
            var placeholder = document.getElementById('previewPlaceholder');

            if (!urlInput || !previewImg || !placeholder) {
                return;
            }

            function showPlaceholder() {
                placeholder.classList.remove('d-none');
                placeholder.classList.add('d-flex');
                previewImg.hidden = true;
            }

            function showImage() {
                placeholder.classList.remove('d-flex');
                placeholder.classList.add('d-none');
                previewImg.hidden = false;
            }

            urlInput.addEventListener('input', function () {
                var url = urlInput.value.trim();

                if (!url) {
                    showPlaceholder();
                    return;
                }

                previewImg.src = url;
            });

            previewImg.addEventListener('load', showImage);
            previewImg.addEventListener('error', showPlaceholder);
        })();
    </script>
}