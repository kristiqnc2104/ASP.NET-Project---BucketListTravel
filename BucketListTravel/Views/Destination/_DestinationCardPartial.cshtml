@model BucketListTravel.ViewModels.Destinations.AllDestinationsIndexViewModel

<div class="card h-100 shadow-sm">
    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 200px; object-fit: cover;">

    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title mb-0">@Model.Name</h5>
            <span class="badge bg-secondary">@Model.CategoryName</span>
        </div>

        <p class="card-text text-muted mb-3">@Model.Country</p>

        <div class="mt-auto d-flex justify-content-between align-items-center">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                Details
            </a>

            @if (Model.IsInBucketList)
            {
                <span class="badge bg-success">In your list</span>
            }
            else
            {
                <form asp-controller="BucketList" asp-action="Add" asp-route-destinationId="@Model.Id" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-success">Add to list</button>
                </form>
            }
        </div>
    </div>
</div>