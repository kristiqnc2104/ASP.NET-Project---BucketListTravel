@model IEnumerable<BucketListTravel.ViewModels.Destinations.AllDestinationsIndexViewModel>

@{
    ViewData["Title"] = "Destinations";
}


<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Destinations</h1>
    <a asp-action="Manage" class="btn btn-outline-secondary">Manage Destinations</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No destinations yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <partial name="_DestinationCardPartial" model="item" />
            </div>
        }
    </div>
}