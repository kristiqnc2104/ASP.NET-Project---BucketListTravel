@model IEnumerable<BucketListTravel.ViewModels.Destinations.AllDestinationsIndexViewModel>

@{
    ViewData["Title"] = "Manage Destinations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Manage Destinations</h1>
    <a asp-action="Create" class="btn btn-primary">Add New</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No destinations yet.</div>
}
else
{
    <form asp-action="DeleteSelected" method="post" onsubmit="return confirm('Delete the selected destinations?');">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th><input type="checkbox" id="selectAll" /></th>
                    <th>Name</th>
                    <th>Country</th>
                    <th>Category</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><input type="checkbox" name="selectedIds" value="@item.Id" class="row-checkbox" /></td>
                        <td>@item.Name</td>
                        <td>@item.Country</td>
                        <td>@item.CategoryName</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-danger">Delete Selected</button>
    </form>
}

@section Scripts {
    <script>
        document.getElementById('selectAll').addEventListener('change', function () {
            document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = this.checked);
        });
    </script>
}