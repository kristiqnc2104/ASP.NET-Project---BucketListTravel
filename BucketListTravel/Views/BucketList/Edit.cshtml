@using BucketListTravel.Common.Enums
@model BucketListTravel.ViewModels.BucketListEntries.EditBucketListEntryViewModel

@{
    ViewData["Title"] = "Edit Bucket List Entry";
}

<section class="edit-page">
    <div class="edit-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Edit Bucket List Entry</h1>
            <p class="text-muted mb-0">Update your plans for @Model.DestinationName.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to My Bucket List</a>
    </div>

    <div class="row">
        <div class="col-lg-8 col-xl-7">
            <div class="card edit-card">
                <div class="card-header">
                    <h2 class="h5 mb-1">@Model.DestinationName</h2>
                    <p class="small text-muted mb-0">Update the status, planned date, or notes.</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="DestinationName" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<VisitStatus>()" class="form-select">
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PlannedDate" class="form-label"></label>
                            <input asp-for="PlannedDate" type="date" class="form-control" />
                            <span asp-validation-for="PlannedDate" class="text-danger"></span>
                            <div class="form-text">Required when the status is Planned; past dates are not allowed.</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
