@model IEnumerable<BucketListTravel.ViewModels.BucketListEntries.AllBucketListEntriesIndexViewModel>

@{
    ViewData["Title"] = "My Bucket List";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">My Bucket List</h1>
        <p class="text-muted mb-0">Keep track of the places you want to visit.</p>
    </div>
    <a asp-controller="Destination" asp-action="Index" class="btn btn-outline-secondary">Browse Destinations</a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h5">Your bucket list is empty</h2>
            <p class="text-muted mb-3">Find a destination that inspires you and add it to your list.</p>
            <a asp-controller="Destination" asp-action="Index" class="btn btn-primary">Explore Destinations</a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var item in Model)
        {
            var statusClass = item.Status switch
            {
                "Visited" => "bg-success",
                "Planned" => "bg-primary",
                _ => "bg-secondary"
            };
            var statusText = item.Status switch
            {
                "WantToVisit" => "Want to visit",
                _ => item.Status
            };

            <div class="col">
                <article class="card h-100 shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.DestinationName" loading="lazy" style="height: 190px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h2 class="h5 card-title mb-0">@item.DestinationName</h2>
                            <span class="badge @statusClass">@statusText</span>
                        </div>
                        <p class="text-muted mb-2">@item.Country</p>
                        <p class="mb-3"><span class="badge bg-light text-dark border">@item.CategoryName</span></p>

                        @if (!string.IsNullOrWhiteSpace(item.PlannedDate))
                        {
                            <p class="small mb-2"><span class="fw-semibold">Planned for:</span> @item.PlannedDate</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <p class="small text-muted mb-3">@item.Notes</p>
                        }
                        <div class="mt-auto pt-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <a asp-controller="Destination" asp-action="Details" asp-route-id="@item.DestinationId" class="btn btn-sm btn-outline-primary">View details</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>

                            <form asp-controller="BucketList" asp-action="Remove" asp-route-destinationId="@item.DestinationId" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </div>
                        <p class="small text-muted mt-2 mb-0">Added @item.DateAdded</p>
                    </div>
                </article>
            </div>
        }
    </div>
}
