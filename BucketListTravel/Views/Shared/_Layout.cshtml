<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BucketListTravel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BucketListTravel.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg site-navbar">
            <div class="container">
                <a class="navbar-brand site-brand" asp-controller="Home" asp-action="Index" aria-label="BucketListTravel home">
                    <span>BucketList<span class="site-brand-accent">Travel</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="mainNavbar" class="collapse navbar-collapse">
                    <ul class="navbar-nav site-nav-links ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Destination" ? "active" : "")" asp-controller="Destination" asp-action="Index">Destinations</a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link site-nav-cta @(ViewContext.RouteData.Values["controller"]?.ToString() == "BucketList" ? "active" : "")" asp-controller="BucketList" asp-action="Index">My Bucket List <span aria-hidden="true">→</span></a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4 py-lg-5 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer border-top bg-white text-muted">
        <div class="container py-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <span>&copy; @DateTime.UtcNow.Year BucketListTravel</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
