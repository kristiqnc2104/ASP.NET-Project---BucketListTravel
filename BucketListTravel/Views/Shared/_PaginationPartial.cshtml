@model BucketListTravel.ViewModels.Common.PaginationViewModel

@if (Model.TotalPages > 1)
{
    var currentPage = Math.Clamp(Model.CurrentPage, 1, Model.TotalPages);
    var firstVisiblePage = Math.Max(2, currentPage - 1);
    var lastVisiblePage = Math.Min(Model.TotalPages - 1, currentPage + 1);

    if (currentPage <= 3)
    {
        lastVisiblePage = Math.Min(Model.TotalPages - 1, 4);
    }
    else if (currentPage >= Model.TotalPages - 2)
    {
        firstVisiblePage = Math.Max(2, Model.TotalPages - 3);
    }

    <nav aria-label="Pagination" class="mt-4">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <p class="small text-muted mb-0">Page <span class="fw-semibold">@currentPage</span> of <span class="fw-semibold">@Model.TotalPages</span></p>

            <ul class="pagination pagination-sm flex-wrap justify-content-center mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    @if (currentPage == 1)
                    {
                        <span class="page-link" aria-disabled="true"><span aria-hidden="true">&laquo;</span><span class="visually-hidden">First page</span></span>
                    }
                    else
                    {
                        <a class="page-link" asp-route-page="1" aria-label="First page"><span aria-hidden="true">&laquo;</span></a>
                    }
                </li>

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    @if (currentPage == 1)
                    {
                        <span class="page-link" aria-disabled="true"><span aria-hidden="true">&lsaquo;</span><span class="visually-hidden">Previous page</span></span>
                    }
                    else
                    {
                        <a class="page-link" asp-route-page="@(currentPage - 1)" aria-label="Previous page"><span aria-hidden="true">&lsaquo;</span></a>
                    }
                </li>

                <li class="page-item @(currentPage == 1 ? "active" : "")">
                    @if (currentPage == 1)
                    {
                        <span class="page-link" aria-current="page">1<span class="visually-hidden">, current page</span></span>
                    }
                    else
                    {
                        <a class="page-link" asp-route-page="1">1</a>
                    }
                </li>

                @if (firstVisiblePage > 2)
                {
                    <li class="page-item disabled" aria-hidden="true"><span class="page-link">&hellip;</span></li>
                }

                @for (int pageNumber = firstVisiblePage; pageNumber <= lastVisiblePage; pageNumber++)
                {
                    <li class="page-item @(pageNumber == currentPage ? "active" : "")">
                        @if (pageNumber == currentPage)
                        {
                            <span class="page-link" aria-current="page">@pageNumber<span class="visually-hidden">, current page</span></span>
                        }
                        else
                        {
                            <a class="page-link" asp-route-page="@pageNumber">@pageNumber</a>
                        }
                    </li>
                }

                @if (lastVisiblePage < Model.TotalPages - 1)
                {
                    <li class="page-item disabled" aria-hidden="true"><span class="page-link">&hellip;</span></li>
                }

                <li class="page-item @(currentPage == Model.TotalPages ? "active" : "")">
                    @if (currentPage == Model.TotalPages)
                    {
                        <span class="page-link" aria-current="page">@Model.TotalPages<span class="visually-hidden">, current page</span></span>
                    }
                    else
                    {
                        <a class="page-link" asp-route-page="@Model.TotalPages">@Model.TotalPages</a>
                    }
                </li>

                <li class="page-item @(currentPage == Model.TotalPages ? "disabled" : "")">
                    @if (currentPage == Model.TotalPages)
                    {
                        <span class="page-link" aria-disabled="true"><span aria-hidden="true">&rsaquo;</span><span class="visually-hidden">Next page</span></span>
                    }
                    else
                    {
                        <a class="page-link" asp-route-page="@(currentPage + 1)" aria-label="Next page"><span aria-hidden="true">&rsaquo;</span></a>
                    }
                </li>

                <li class="page-item @(currentPage == Model.TotalPages ? "disabled" : "")">
                    @if (currentPage == Model.TotalPages)
                    {
                        <span class="page-link" aria-disabled="true"><span aria-hidden="true">&raquo;</span><span class="visually-hidden">Last page</span></span>
                    }
                    else
                    {
                        <a class="page-link" asp-route-page="@Model.TotalPages" aria-label="Last page"><span aria-hidden="true">&raquo;</span></a>
                    }
                </li>
            </ul>
        </div>
    </nav>
}

